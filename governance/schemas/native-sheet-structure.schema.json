{
  "$id": "https://github.com/deep-blue-zero/anime-manga-ln-games-analysis/blob/main/governance/schemas/native-sheet-structure.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native Google Sheet deterministic text representation v1",
  "description": "Structure and exact-byte bindings for a verified native-sheet export represented in Git as one rectangular UTF-8/LF TSV per worksheet. The source XLSX remains outside Git.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "created_utc",
    "source_drive_id",
    "source_drive_revision",
    "source_byte_length",
    "source_sha256",
    "workbook_format",
    "conversion",
    "worksheet_count",
    "worksheets"
  ],
  "properties": {
    "schema": {"const": "manga-anime-git-migration/native-sheet-structure/v1"},
    "created_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$(?![\\s\\S])"
    },
    "source_drive_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{10,}$(?![\\s\\S])"
    },
    "source_drive_revision": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$(?![\\s\\S])"
    },
    "source_byte_length": {"type": "integer", "minimum": 1},
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "workbook_format": {"const": "xlsx"},
    "conversion": {"$ref": "#/$defs/conversion"},
    "worksheet_count": {"type": "integer", "minimum": 1},
    "worksheets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/worksheet"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
    },
    "conversion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "engine_version",
        "encoding",
        "line_ending",
        "blank_cell_policy"
      ],
      "properties": {
        "engine": {"const": "openpyxl"},
        "engine_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$(?![\\s\\S])"
        },
        "encoding": {"const": "UTF-8"},
        "line_ending": {"const": "LF"},
        "blank_cell_policy": {"const": "NONE_OR_EMPTY_STRING_TO_EMPTY_FIELD"}
      }
    },
    "worksheet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "name",
        "address",
        "rows",
        "columns",
        "tables",
        "formula_cells",
        "tsv_destination_path",
        "tsv_sha256"
      ],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$(?![\\s\\S])"
        },
        "address": {
          "type": "string",
          "pattern": "^A1:[A-Z]+[1-9][0-9]*$(?![\\s\\S])"
        },
        "rows": {"type": "integer", "minimum": 1},
        "columns": {"type": "integer", "minimum": 1},
        "tables": {"const": 0},
        "formula_cells": {"type": "array", "maxItems": 0},
        "tsv_destination_path": {
          "type": "string",
          "pattern": "^studies/[^/]+/.+\\.tabs/[0-9]{2,}-[a-z0-9]+(?:-[a-z0-9]+)*\\.tsv$(?![\\s\\S])"
        },
        "tsv_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
